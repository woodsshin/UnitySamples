# ShipTriangle.obj
# 우주선(플레이어) 삼각형 메쉬 - Triangle_White.png / Triangle_Dead.png UV에 맞춤
# 크기: 1 유니트 (local -0.5~0.5 근방), 앞(전방)=+Y, 평면=XY, Z=0
# 앞/뒤 와인딩 모두 포함(더블사이드): Unity 임포트 시 와인딩 해석에 관계없이 렌더링됨
# -> 확인 후 필요 없으면 뒷면 폴리곤(f 2번째 줄) 삭제해서 정점수 절반으로 최적화 가능
o ShipTriangle

v 0.000000 0.440000 0.000000
v -0.360000 -0.420000 0.000000
v 0.360000 -0.420000 0.000000

vn 0.0 0.0 1.0
vn 0.0 0.0 -1.0

vt 0.492188 0.937500
vt 0.140625 0.078125
vt 0.843750 0.078125

f 1/1/1 3/3/1 2/2/1
f 1/1/2 2/2/2 3/3/2
